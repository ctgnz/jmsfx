<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <name>JMSFX Icon Creator</name>
    <artifactId>jmsfx-creator</artifactId>
    <packaging>jar</packaging>

    <parent>
        <groupId>io.github.ctgnz</groupId>
        <artifactId>jmsfx-viewer</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>        
    </parent>

    <dependencies>
        <!--
            Compiled against the interfaces only. The creator works through IconLibrary and names no
            concrete library, so the same build runs against any of them - jmsfx-standard here, or a
            library generated from an extended model elsewhere. See #76.
        -->
        <dependency>
            <groupId>io.github.ctgnz</groupId>
            <artifactId>jmsfx-core</artifactId>
            <version>${jmsfx.core.version}</version>
        </dependency>

        <!--
            No library is declared here. Which one this ships with is chosen by a profile in
            jmsfx-viewer - -Pstandard, -Phistorical - so one source tree produces one bundle per library
            rather than a build that hard-codes its answer. See jmsfx#112.

            It stays out of compile scope there too, deliberately: nothing here may quietly bind to a
            generated type, so a stray import fails on a standard-only type rather than shipping an
            application that only works against one library. See jmsfx#76.

            The <optional> that used to sit on it is gone. It was there to stop runtime scope
            propagating to consumers, but since jmsfx#109 nothing consumes an application as a
            library, and it is a live trap next door: spring-boot:repackage leaves optional
            dependencies out of BOOT-INF/lib, so the same declaration in jmsfx-server produced a jar
            that started and then answered 500 to everything. See jmsfx#93.
        -->
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <subpackages>io.github.ctgnz.jmsfx.icon.creator</subpackages>
                </configuration>
            </plugin>
            <!-- jpackage takes a directory of jars rather than a classpath, so the
                 runtime dependencies are gathered next to the application jar. The
                 JavaFX artifacts resolve to the building platform's classifier,
                 which is what we want: each platform builds its own bundle. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>collect-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.github.ctgnz.jmsfx.icon.creator.IconCreatorLauncher</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>