<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<artifactId>jmsfx-server</artifactId>
	<name>JMSFX Icon Generator - Web Server</name>
	
	<parent>
        <groupId>io.github.ctgnz</groupId>
        <artifactId>jmsfx-viewer</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>        
    </parent>

    <properties>
        <spring.boot.version>4.1.1</spring.boot.version>
    </properties>
	
	<dependencies>
	    <dependency>
	        <groupId>org.springframework.boot</groupId>
	        <artifactId>spring-boot-starter-webmvc</artifactId>
            <version>${spring.boot.version}</version>
	    </dependency>
	    <dependency>
	        <groupId>org.springframework.boot</groupId>
	        <artifactId>spring-boot-starter-thymeleaf</artifactId>
            <version>${spring.boot.version}</version>
	    </dependency>
	    <dependency>
	        <groupId>io.github.ctgnz</groupId>
	        <artifactId>jmsfx-core</artifactId>
	        <version>${jmsfx.core.version}</version>
	    </dependency>
	    <!-- The library comes from the active profile in jmsfx-viewer: -Pstandard, -Phallux.
	         runtime, and never optional - spring-boot:repackage drops optional dependencies from
	         BOOT-INF/lib, so an optional library never reaches this jar. See jmsfx#93, jmsfx#112. -->
        <!-- JavaFX resolves its native classifier from the build host, so a jar
             built on Windows cannot render on the Linux server. Icon composition
             goes through a JavaFX scene graph even for SVG output, so the Linux
             natives have to travel with the artifact. -->
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-base</artifactId>
            <version>${javafx.version}</version>
            <classifier>linux</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-graphics</artifactId>
            <version>${javafx.version}</version>
            <classifier>linux</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-controls</artifactId>
            <version>${javafx.version}</version>
            <classifier>linux</classifier>
        </dependency>
        <dependency>
            <groupId>org.openjfx</groupId>
            <artifactId>javafx-swing</artifactId>
            <version>${javafx.version}</version>
            <classifier>linux</classifier>
        </dependency>
        <dependency>
          <groupId>org.springframework.boot</groupId>
          <artifactId>spring-boot-devtools</artifactId>
            <version>${spring.boot.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.xml.bind</groupId>
            <artifactId>jakarta.xml.bind-api</artifactId>
            <version>4.0.5</version>
        </dependency>
        <dependency>
            <groupId>org.glassfish.jaxb</groupId>
            <artifactId>jaxb-runtime</artifactId>
            <version>4.0.9</version>
        </dependency>

	    <dependency>
	        <groupId>org.junit.jupiter</groupId>
	        <artifactId>junit-jupiter</artifactId>
	        <scope>test</scope>
	    </dependency>
	    <dependency>
	        <groupId>org.hamcrest</groupId>
	        <artifactId>hamcrest</artifactId>
	        <scope>test</scope>
	    </dependency>
	</dependencies>
	
	<build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <!-- ctg-brand submodule, copied in alongside the vendored Bootstrap
                 so it is served at /css/brand.css like any other stylesheet -->
            <resource>
                <directory>${project.basedir}/../../brand/css</directory>
                <targetPath>bootstrap/css</targetPath>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <excludePackageNames>io.github.ctgnz.jmsfx.server.icon,io.github.ctgnz.jmsfx.server.model</excludePackageNames>
                    <subpackages>io.github.ctgnz.jmsfx.server</subpackages>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <configuration>
                    <mainClass>io.github.ctgnz.jmsfx.server.JmsfxServer</mainClass>
                    <!--
                        One build product per library, identifiable from its filename:
                        jmsfx-server-2.0.0-standard.jar, -hallux. That matters once three of these
                        are being shipped to three boxes, where "which library is in this jar" must
                        not depend on remembering how it was built. jmsfx#112.

                        A classifier here also leaves the thin jar as the main artifact rather than
                        replacing it, so there is no .original beside it any more - the fat jar is
                        the classified one. deploy.sh selects on that.
                    -->
                    <classifier>${jmsfx.library}</classifier>
                </configuration>
                <executions>
                    <execution>
                        <id>package-jar</id>
                        <phase>post-integration-test</phase>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-assembly-plugin</artifactId>
                <configuration>
                    <descriptors>
                        <descriptor>source-bundle.xml</descriptor>
                    </descriptors>
                </configuration>
                <executions>
                    <execution>
                        <id>create-source-bundle</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>single</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
	</build>

</project>