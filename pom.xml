<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<groupId>io.github.ctgnz</groupId>
	<artifactId>jmsfx</artifactId>
	<version>2.0.0-SNAPSHOT</version>
	<packaging>pom</packaging>
	<name>JMSFX - Joint Military Symbology on JavaFX</name>
	<description>A JavaFX implementation of NATO APP-6E military symbology: a generated domain model of the standard, and the SVG composition that draws a symbol from it.</description>

	<parent>
		<groupId>io.github.ctgnz</groupId>
		<artifactId>jmsfx-parent</artifactId>
		<version>2.0.0-SNAPSHOT</version>
		<relativePath>jmsfx-parent/pom.xml</relativePath>
	</parent>

	<!--
		An aggregator, and deliberately nothing else. Everything that configures a build moved to
		jmsfx-parent, which carries no modules - so the shared configuration can be versioned and
		released on its own, and bumping it is one edit rather than one per module. This file only
		answers "what is in this repository". See jmsfx#102.

		It is a module of itself, which looks odd and is the normal way to do this: jmsfx-parent is
		built by this reactor, so it has to be listed, and it is found by relativePath rather than
		needing to be installed first.
	-->
	<!--
		Grouped by deliverable, not flat. jmsfx-tools and jmsfx-viewer are real poms because their
		children share a release; the libraries sit in a plain library/ directory because theirs is
		exactly the lifecycle that should not be shared - standard tracks the APP-6E standard, and
		each extension tracks its own domain. See jmsfx#102.
	-->
	<modules>
		<module>jmsfx-parent</module>
		<module>jmsfx-core</module>
		<module>jmsfx-tools</module>
		<module>jmsfx-viewer</module>
		<module>library/jmsfx-standard</module>
		<module>library/jmsfx-hallux</module>
	</modules>

</project>
