<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <artifactId>jmsfx-generator</artifactId>
    <name>Meta-Model Generator for APP-6D Joint Military Symbology</name>
    
    <parent>
        <groupId>io.github.ctgnz</groupId>
        <artifactId>jmsfx</artifactId>
        <version>1.5.0</version>
        <relativePath>../pom.xml</relativePath>        
    </parent>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <lombok.version>1.18.6</lombok.version>
        <jackson.version>2.22.2</jackson.version>
    </properties>
    
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>6.1.3</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Used only by FragmentMeasurer, which measures the SVG fragments and writes their bounds
             into the model file. Code generation itself never touches it, so generating stays
             headless - only re-measuring needs a JavaFX toolkit, and that runs on a dev machine
             or CI when the fragments change. -->
        <dependency>
            <groupId>io.github.ctgnz</groupId>
            <artifactId>foxglove</artifactId>
            <version>${foxglove.version}</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-lang3</artifactId>
            <version>3.20.0</version>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-text</artifactId>
            <version>1.15.0</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-core</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-yaml</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-guava</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.datatype</groupId>
            <artifactId>jackson-datatype-jsr310</artifactId>
            <version>${jackson.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.guava</groupId>
            <artifactId>guava</artifactId>
            <version>33.7.1-jre</version>
        </dependency>
        <dependency>
            <groupId>org.freemarker</groupId>
            <artifactId>freemarker</artifactId>
            <version>2.3.35</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <version>3.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <skip>true</skip>
                </configuration>
            </plugin>
            <!--
                Two checks over the SVG fragments, both of which report only and never write, and both
                of which fail naming the files, the way Spotless does for Java.

                The first checks they are still normalised. The normaliser's apply mode is the fix, and
                the failure message spells out the command.

                The second checks the free canvas fragments still hold the shape described in
                svg/README.md - one main group, an optional template, any number of examples - because
                injecting fragments into the generated classes needs a rule for "which element is the
                content" and that is the rule. A fragment drifts off it easily: an editor leaves a group
                anonymous, or a new icon arrives with its content loose at the root. Catching that here
                costs nothing; catching it during injection means finding construction scaffolding
                rendered as though it were the drawing.

                Bound to verify rather than written as a test, so skipping tests cannot skip it, and at
                verify for the same reason Spotless is there: late enough not to slow the inner loop,
                early enough that nothing is published without it.

                The directory is passed from the module layout rather than read from config.yml, whose
                resourceDir is an absolute Windows path and so resolves nowhere on a CI runner. A
                directory that is not present is skipped rather than failing, which keeps partial
                reactor builds and partial checkouts working.

                hallux's fragments are not covered: the tool lives here and that repo has no dependency
                on it. See jmsfx#73 and jmsfx#81, the same coupling question the model split must answer.
            -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <version>3.6.4</version>
                <executions>
                    <execution>
                        <id>check-fragments-normalised</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>io.github.ctgnz.jmsfx.generator.FragmentNormaliser</mainClass>
                            <arguments>
                                <argument>--check</argument>
                                <argument>--dir</argument>
                                <argument>${project.basedir}/../jmsfx-standard/src/main/resources/svg</argument>
                            </arguments>
                        </configuration>
                    </execution>
                    <execution>
                        <id>check-fragment-shape</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>java</goal>
                        </goals>
                        <configuration>
                            <mainClass>io.github.ctgnz.jmsfx.generator.FragmentShapeChecker</mainClass>
                            <arguments>
                                <argument>--dir</argument>
                                <argument>${project.basedir}/../jmsfx-standard/src/main/resources/svg</argument>
                                <argument>--model</argument>
                                <argument>/model-standard.yml</argument>
                            </arguments>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>