<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <name>JMSFX Core API</name>
    <artifactId>jmsfx-core</artifactId>
    <packaging>jar</packaging>

    <parent>
        <groupId>io.github.ctgnz</groupId>
        <artifactId>jmsfx-parent</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../jmsfx-parent/pom.xml</relativePath>        
    </parent>


    <dependencies>
        <dependency>
            <groupId>io.github.ctgnz</groupId>
            <artifactId>foxglove</artifactId>
            <version>${foxglove.version}</version>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.hamcrest</groupId>
            <artifactId>hamcrest</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <!--
                    A test jar, so the injected-markup contract has one copy rather than one per library.
                    The checks are library-agnostic - they reach everything through IconLibrary.discover()
                    and jmsfx-core's own interfaces - but they cannot run here, because jmsfx-core
                    deliberately has no library on its classpath (jmsfx#76). So they live here and run
                    there, and each library's own test is a subclass with nothing in it.

                    Triplicating them was the alternative, and verification code that exists three times
                    is verification code that drifts. See jmsfx#122.
                -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <executions>
                    <execution>
                        <id>test-jar</id>
                        <goals>
                            <goal>test-jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <subpackages>io.github.ctgnz.jmsfx</subpackages>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>