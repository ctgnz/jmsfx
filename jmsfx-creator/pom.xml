<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <name>JMSFX Model</name>
    <artifactId>jmsfx-creator</artifactId>
    <packaging>jar</packaging>

    <parent>
        <groupId>io.github.ctgnz</groupId>
        <artifactId>jmsfx</artifactId>
        <version>2.0.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>        
    </parent>

    <dependencies>
        <!--
            Compiled against the interfaces only. The creator works through IconLibrary and names no
            concrete library, so the same build runs against any of them - jmsfx-standard here, or a
            library generated from an extended model elsewhere. See #76.
        -->
        <dependency>
            <groupId>io.github.ctgnz</groupId>
            <artifactId>jmsfx-core</artifactId>
            <version>2.0.0-SNAPSHOT</version>
        </dependency>

        <!--
            A library has to be present to run, and this is the one the packaged desktop bundle ships.

            Runtime scope rather than compile, so nothing here can quietly bind to it again: the build
            fails on a standard-only type rather than shipping an application that only works against
            one library.

            Optional because runtime scope is transitive, and this must not be. Anything depending on
            jmsfx-creator to run the application against *its* library would otherwise inherit this one
            too, put two IconLibrary implementations on the classpath, and be refused by discovery - which
            is exactly what hallux hit. Optional stops it propagating while leaving it on this module's
            own runtime classpath, so copy-dependencies still gathers it into the bundle below and the
            application runs standalone.

            A consumer that supplies no library gets discovery's "none on the classpath" error, which says
            what to add.
        -->
        <dependency>
            <groupId>io.github.ctgnz</groupId>
            <artifactId>jmsfx-standard</artifactId>
            <version>2.0.0-SNAPSHOT</version>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <sourceDirectory>src/main/java</sourceDirectory>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <includes>
                    <include>**</include>
                </includes>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-resources-plugin</artifactId>
                <version>3.3.1</version>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <subpackages>io.github.ctgnz.jmsfx.icon.creator</subpackages>
                </configuration>
            </plugin>
            <!-- jpackage takes a directory of jars rather than a classpath, so the
                 runtime dependencies are gathered next to the application jar. The
                 JavaFX artifacts resolve to the building platform's classifier,
                 which is what we want: each platform builds its own bundle. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <executions>
                    <execution>
                        <id>collect-runtime-dependencies</id>
                        <phase>package</phase>
                        <goals>
                            <goal>copy-dependencies</goal>
                        </goals>
                        <configuration>
                            <outputDirectory>${project.build.directory}/lib</outputDirectory>
                            <includeScope>runtime</includeScope>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>io.github.ctgnz.jmsfx.icon.creator.IconCreatorLauncher</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>